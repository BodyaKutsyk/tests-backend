## Internal port used by the backend API inside the container.
API_INTERNAL_PORT=3000
## External host port mapped to the backend API.
API_EXTERNAL_PORT=5137
Name of the PostgreSQL database.
POSTGRES_DB=my_db
PostgreSQL application user used by the backend.
POSTGRES_USER=app_user
Initial password for the PostgreSQL application user.
POSTGRES_USER_PASSWORD=db_password
PostgreSQL administrator username.
POSTGRES_ADMIN=admin
Password for the PostgreSQL administrator.
POSTGRES_ADMIN_PASSWORD=admin_password
 Path to the file containing the current rotated application user password.
POSTGRES_PASSWORD_FILE=/run/secrets/db_password
