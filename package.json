{
  "name": "api_design",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "pnpm test --onlyChanged",
    "test:cov": "pnpm test --coverage",
    "test:debug": "pnpm test --debug",
    "test:e2e": "pnpm test --config=jest.config.e2e.ts",
    "openapi:lint": "npx @redocly/cli lint openapi/openapi.yaml",
    "openapi:build": "npx @redocly/cli build-docs openapi/openapi.yaml -o openapi/docs.html",
    "check:env": "node scripts/check-env-example.mjs",
    "infisical": "bash infisical.sh",
    "docker:build": "pnpm infisical docker compose build",
    "docker:build:prod": "pnpm infisical docker compose -f docker-compose.yaml build",
    "docker:start:dev": "pnpm docker:build && pnpm infisical docker compose up --watch",
    "docker:stop:dev": "pnpm infisical docker compose down",
    "docker:start:prod": "pnpm docker:build:prod && pnpm infisical docker compose -f docker-compose.yaml up -d",
    "docker:stop:prod": "pnpm infisical docker compose -f docker-compose.yaml down",
    "migrate:generate": "pnpm infisical typeorm migration:generate -d dist/data-source.js src/migrations/generate-db && pnpm build",
    "migrate": "pnpm infisical typeorm migration:run -d dist/data-source.js",
    "migrate:show": "pnpm infisical typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "pnpm infisical typeorm migration:revert -d dist/data-source.js",
    "seed": "pnpm infisical pnpm exec tsx db/seed.ts",
    "demo:nplus1": "pnpm exec tsx src/demo-nplus1.ts",
    "demo:race": "pnpm exec tsx src/race-transaction.ts",
    "demo:workers": "pnpm exec tsx src/workers-transactions.ts",
    "demo:retry": "pnpm exec tsx src/retry-transaction.ts",
    "report": "pnpm exec tsx src/report.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@pact-foundation/pact": "^17.1.3",
    "@redocly/cli": "^2.49.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "dotenv": "^17.4.2",
    "jest": "^30.5.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
